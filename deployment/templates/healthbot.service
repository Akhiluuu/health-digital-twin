[Unit]
Description=Health AI — Dr. Aria Chatbot (VitalHealth)
Documentation=https://github.com/Akhiluuu/health-digital-twin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{GROUP}}
WorkingDirectory={{PROJECT_DIR}}

# health_ai.* imports are resolved via the symlink:
#   {{PROJECT_DIR}}/health_ai -> {{PROJECT_DIR}}/healthbot
Environment=PYTHONPATH={{PROJECT_DIR}}

# Start the healthbot on port 8001 using its dedicated venv
# Single worker: GGUF LLM cannot be safely shared across processes
ExecStart={{PROJECT_DIR}}/healthbot_venv/bin/uvicorn \
    healthbot.api.server:app \
    --host 127.0.0.1 \
    --port 8001 \
    --workers 1 \
    --log-level info \
    --access-log

# Auto-restart on crash
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=healthbot

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
