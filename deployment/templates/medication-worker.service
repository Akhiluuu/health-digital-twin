[Unit]
Description=VitalHealth Medication Celery Worker + Beat Scheduler
After=network-online.target medication.service
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{GROUP}}
WorkingDirectory={{PROJECT_DIR}}
EnvironmentFile={{PROJECT_DIR}}/.env

ExecStart={{PROJECT_DIR}}/med_venv/bin/celery \
    -A medication_service.workers.celery_workers.celery_app \
    worker --beat \
    --scheduler celery.beat.PersistentScheduler \
    --queues medication \
    --loglevel=info \
    --concurrency=2

Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=medication-worker

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
