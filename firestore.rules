rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        (resource != null && resource.data != null && resource.data.managedBy == request.auth.uid) ||
        (request.resource != null && request.resource.data != null && request.resource.data.managedBy == request.auth.uid) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedMembers != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedMembers[userId] != null)
      );
      
      match /{document=**} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          (exists(/databases/$(database)/documents/users/$(userId)) && 
           get(/databases/$(database)/documents/users/$(userId)).data != null &&
           get(/databases/$(database)/documents/users/$(userId)).data.managedBy == request.auth.uid) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedMembers != null &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedMembers[userId] != null)
        );
      }
    }
  }
}
